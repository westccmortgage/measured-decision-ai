{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noble takeoff comparison — one result format for every provider",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "model", "tasks"],
  "properties": {
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D", "E"],
      "properties": {
        "A": { "$ref": "#/$defs/rows" }, "B": { "$ref": "#/$defs/rows" }, "C": { "$ref": "#/$defs/rows" },
        "D": { "$ref": "#/$defs/rows" }, "E": { "$ref": "#/$defs/rows" }
      }
    }
  },
  "$defs": {
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "mark", "material", "section", "quantity", "unit", "counted", "plies", "length", "method", "sheet", "source_location", "unresolved"],
      "properties": {
        "category": { "type": "string", "enum": ["beam", "header", "ridge", "hip", "rafter", "joist", "footing", "stud", "sheathing", "blocking", "connector", "fastener", "strap", "holdown", "other"] },
        "mark": { "type": "string", "description": "As printed. A general label (RHDR) stays general unless a printed rule assigns the numbered mark." },
        "material": { "type": "string" },
        "section": { "type": "string", "description": "As printed, e.g. '3-1/2 x 18', '(2)-2x10 #2'." },
        "quantity": { "type": ["number", "null"], "description": "null when unknown. Never 0 for unknown." },
        "unit": { "type": "string", "enum": ["each", "zone", "assembly", "piece", "lf", "sf", "rule", ""] },
        "counted": { "type": "string", "enum": ["zone", "member", "assembly", "piece", "none"], "description": "What the quantity counts." },
        "plies": { "type": ["integer", "null"], "description": "Constituents per assembly, when the schedule prints a make-up." },
        "length": { "type": ["string", "null"], "description": "Printed length only; null when not printed." },
        "method": { "type": "string", "enum": ["printed", "counted_on_plan", "derived", "proposed"] },
        "sheet": { "type": "string" },
        "source_location": { "type": "string", "description": "Exact place: schedule name and row, note number, or enlargement name + pixel x,y of the label in the kit's coordinate frame." },
        "placements": {
          "type": "array",
          "description": "Task B and C: one entry per counted member/place, so misses and double counts can be checked.",
          "items": { "type": "object", "additionalProperties": false, "required": ["image", "x", "y"], "properties": { "image": { "type": "string" }, "x": { "type": "integer" }, "y": { "type": "integer" }, "label": { "type": "string" } } }
        },
        "unresolved": { "type": "string", "description": "What stayed uncertain. Reading difficulty goes here (internal check), never as an RFI." },
        "rfi": { "type": "string", "description": "Only where the design itself is ambiguous." }
      }
    }
  }
}
